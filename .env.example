OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
# Set to false for third-party gateways that only support Chat Completions
# (the SDK defaults to the Responses API when unset).
OPENAI_USE_RESPONSES=

ADMIN_TOKEN=change-me-before-deploying
RUNTIME_CONFIG_PATH=/Users/dto/code/ydgi/muslim_bot/.data/runtime_config.json

QURAN_SOURCE_DB_PATH=/Users/dto/code/ydgi/quran-api-go/data/quran.db
QURAN_API_DIR=/Users/dto/code/ydgi/quran-api-go
QURAN_DB_PATH=/Users/dto/code/ydgi/muslim_bot/.data/quran.db
QURAN_MCP_COMMAND=go
QURAN_MCP_ARGS=run ./cmd/mcp
QURAN_MCP_CWD=/Users/dto/code/ydgi/quran-api-go

HADITH_API_DIR=/Users/dto/code/ydgi/hadith-api-go-run
HADITH_DB_PATH=/Users/dto/code/ydgi/muslim_bot/.data/hadith.db
HADITH_MCP_COMMAND=go
HADITH_MCP_ARGS=run ./cmd/mcp
HADITH_MCP_CWD=/Users/dto/code/ydgi/hadith-api-go-run
HADITH_SEEDER_COMMAND=go
HADITH_SEEDER_ARGS=run ./cmd/seeder
HADITH_SEEDER_CWD=/Users/dto/code/ydgi/hadith-api-go-run

MCP_STARTUP_TIMEOUT_SECONDS=45
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_TURNS=10
SESSION_MAX_TURNS=12
SESSION_DB_PATH=
SESSION_RETENTION_DAYS=7
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_CACHE_ENABLED=true
ANSWER_CACHE_TTL_DAYS=7

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=http://127.0.0.1:8021
# Optional: HTTP/SOCKS proxy if api.telegram.org is unreachable directly,
# e.g. TELEGRAM_PROXY=http://127.0.0.1:1080
TELEGRAM_PROXY=
TELEGRAM_CONNECT_TIMEOUT=10
TELEGRAM_READ_TIMEOUT=30

# Seconds between MCP connection health checks (0 = every request).
MCP_HEALTH_CHECK_INTERVAL_SECONDS=30
# Set to false if the LLM gateway rejects parallel_tool_calls.
AGENT_PARALLEL_TOOL_CALLS=true
# Set to false to always use the legacy tool-calling agent loop.
AGENT_PIPELINE_ENABLED=true

# Semantic (embedding) fallback when keyword search is weak. Build the index first:
#   python -m muslim_bot.semantic_index
SEMANTIC_SEARCH_ENABLED=true
# Build the index in the background at start-up when it is missing.
SEMANTIC_AUTO_INDEX=true
SEMANTIC_DB_PATH=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# Hijri calendar (unofficial MABIMS API, based on Kemenag tables). When it is down the bot
# falls back to a local Umm al-Qura calculation and labels the date as approximate.
HIJRI_API_ENABLED=true
HIJRI_API_BASE=https://api.mabims.dev/api/v1
HIJRI_API_TIMEOUT_SECONDS=3
